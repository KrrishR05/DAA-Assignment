class Solution {
    public int search(int[] nums, int target) {
        int start=0, end = nums.length-1;

        while(start<=end){
            int mid = start + (end-start)/2;
            if(nums[mid] == target){
                return mid;
            }
            if(nums[mid] >= nums[start]){ //if left half (4,5,6,7) is sorted
                if(target >= nums[start] && target < nums[mid]){
                    end = mid-1; //serach left half
                }else{
                    start = mid+1; //search right half
                }
            }
            else{ //if right half (0,1,2) is sorted
                if(target > nums[mid] && target <= nums[end]){
                    start = mid+1;
                } else{
                    end = mid-1;
                }
            }
        }
        return -1;
    }
}
